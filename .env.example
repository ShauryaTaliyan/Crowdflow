# ==========================================
# CrowdFlow Environment Variables Configuration
# ==========================================

# 1. FRONTEND ENVIRONMENT VARIABLES (for Netlify / Vite)
# --------------------------------------------------------
# Leave empty for local development (defaults to local Vite proxy).
# When deploying frontend to Netlify and backend to Render/Railway/Fly.io,
# set this in your Netlify dashboard to your deployed backend URL:
# VITE_API_BASE_URL=https://crowdflow-backend.onrender.com
VITE_API_BASE_URL=


# 2. BACKEND ENVIRONMENT VARIABLES (for Render / Railway / Docker / VPS)
# -----------------------------------------------------------------------
# (Optional) Port the FastAPI backend listens on (defaults to 8000 or provided by host $PORT)
PORT=8000

# (Optional) Public URL of your deployed frontend (e.g. Netlify URL).
# Used by QR codes so mobile phone cameras open the correct web link:
# PUBLIC_FRONTEND_URL=https://your-crowdflow.netlify.app
PUBLIC_FRONTEND_URL=

# (Optional) Public URL of your deployed backend.
# Passed to mobile cameras so they stream video to this server:
# PUBLIC_BACKEND_URL=https://crowdflow-backend.onrender.com
PUBLIC_BACKEND_URL=
